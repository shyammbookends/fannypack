# PostgreSQL database
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/fannypack

# API port (Vite proxies /api here in development)
PORT=5000

# Razorpay - fill in your keys to enable online payment (test keys start with rzp_test_).
# The keys can also be added in Admin -> Integrations instead.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# 32-byte key (64 hex chars): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Public URL of the site, e.g. https://fannypack.in (used in email links, sitemap and share tags)
PUBLIC_URL=http://localhost:5173

# MUST be "production" on the live server: turns on Secure cookies, HTTPS-only (HSTS) and the
# Content-Security-Policy, and stops emails from being printed in the server log.
NODE_ENV=development

# Behind a reverse proxy / load balancer (Nginx, Render, Railway…) set this so rate limits see the
# real visitor IP, e.g. TRUST_PROXY=1  (default: loopback)
# TRUST_PROXY=1

# Email (order updates to customers, password-reset links, admin alerts).
# Without SMTP_PASS, emails are only printed in the server console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Bookends Fanny Pack <you@example.com>

# Where `npm run db:backup` writes backups (default: ./backups)
# BACKUP_DIR=backups
