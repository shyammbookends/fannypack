# ======================= BACKEND SETTINGS =======================
# Copy this file to .env and fill it in. Never commit .env.

# PostgreSQL database
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/fannypack
# Database connections per server process (stay below the database's max_connections)
DB_POOL_MAX=20

# API port. In development the frontend (npm run dev in frontend/) forwards /api here.
PORT=5000

# "production" on the live server: Secure cookies, HTTPS headers, no emails printed in logs
NODE_ENV=development

# Public address of the website, e.g. https://fannypack.in (email links, sitemap, share tags). Required in production.
PUBLIC_URL=http://localhost:5173

# 32-byte key (64 hex chars) - encrypts integration secrets, 2FA keys and backups. Keep a safe copy!
# Make one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Razorpay (or add the keys in Admin -> Integrations). Empty = Cash on Delivery only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email: order updates, password-reset links, admin alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Bookends Fanny Pack <you@example.com>

# Behind a proxy, so rate limits see the real visitor IP (number of proxies in front of the server):
#   Nginx / Caddy / one load balancer = 1,  Firebase Hosting -> Cloud Run = 2
# Check: Admin -> Audit logs should show your own public IP after you sign in.
# TRUST_PROXY=1

# Folders (relative to the backend folder)
# FRONTEND_DIST = built website for the backend to serve itself (leave as is unless the frontend lives elsewhere)
FRONTEND_DIST=../frontend/dist
UPLOAD_DIR=uploads
BACKUP_DIR=backups
